rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /picks/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Owner can self-manage displayName/photoURL, but isAdmin is settable
      // only server-side (Admin SDK bypasses rules) — never via client write.
      allow create: if request.auth != null && request.auth.uid == userId
        && !('isAdmin' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /submissions/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // read-only backup after migration
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /outcomes/official {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /liveData/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions (admin SDK)
    }

    match /matches/{eventId} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions (admin SDK)
    }

    match /groups/{letter} {
      allow read: if request.auth != null;
      allow write: if false; // written only by Cloud Functions (admin SDK)
    }
  }
}
